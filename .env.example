# Run python3 scripts/setup.py after provisioning the local images and model volume.
# No password is stored in this file; setup never downloads images, packages or weights.
# Keep deployment-specific addresses in the ignored .env, not in this template.
SITE_ADDRESS=localhost
PUBLIC_ORIGIN=https://localhost:6500
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=6500
HTTP_PORT=6501
# Container listener; use 8082 with SITE_ADDRESS=http://:8082 behind Tailscale Serve.
FRONTEND_PORT=8443
# Optional additional exact browser origins, separated by spaces.
ADDITIONAL_PUBLIC_ORIGINS=
# Optional LAN HTTPS alongside Tailscale; keep BIND_ADDRESS=127.0.0.1.
# COMPOSE_FILE=compose.yaml:compose.lan.yaml
# LAN_ADDRESS=192.168.1.10
# LAN_HTTPS_PORT=6502
ADMIN_USERNAME=admin
# setup.py detects the local Docker Unix socket, including rootless Docker.
MODEL_DOCKER_SOCKET=/var/run/docker.sock

ASR_IMAGE=sphinx-asr:0.3.0
LLM_IMAGE=sphinx-llm:0.3.0
TTS_IMAGE=sphinx-tts:0.3.0
# Shared, externally managed weights; all model services mount this volume read-only.
MODEL_WEIGHTS_VOLUME=ai-models
# Writable runtime caches belong to this application, separate from shared weights.
TORCH_CACHE_VOLUME=sphinx_torch_cache
COSYVOICE_CACHE_VOLUME=sphinx_cosyvoice_cache
VLLM_CACHE_VOLUME=sphinx_vllm_cache
# Images and weights must already exist. Model services always run offline.
VOICE_GPU=0
LLM_GPU_0=0
LLM_GPU_1=1

# Optional ingestion profile: pinned n8n/runtime + PostgreSQL/pgvector.
# Provision images once, then run python3 scripts/setup_ingestion.py.
N8N_IMAGE=n8nio/n8n@sha256:4384b9ff20a78bc1708c35ce7864f84f724611de7801fb36d715998db7c000f1
N8N_RUNNER_IMAGE=n8nio/runners@sha256:7ae8720b0c2e1c3504cb4386394183ced00fa227697e4fa47f095b0e368827b6
VECTOR_DB_IMAGE=pgvector/pgvector@sha256:0dd3149a06e4579a0d70d8fef9945636cd514005e7237deb27f9b67886f8dc4f
N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678
# Ollama on the Docker host; replace with a reachable IP for another host
# or if the Docker/rootless network requires an explicit host address.
# Both paths use the same pinned bge-m3 revision; no Tailscale service routing.
OLLAMA_HOST_ADDRESS=host-gateway
# Initial cosine-similarity filter; calibrate against real document questions.
KNOWLEDGE_MIN_SCORE=0.45
